<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:paddingLeft="16dp"
    android:paddingRight="8dp"
    android:paddingTop="12dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/preset_text"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:textColor="?android:attr/textColorPrimary"
        android:textSize="16sp" />

    <ImageView
        android:id="@+id/btn_edit_preset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_mode_edit_black_24dp"
        android:tint="@color/theme_accent"
        android:scaleType="center"
        android:contentDescription="@string/btn_edit_preset"
        android:clickable="true"
        android:focusable="false" />

    <ImageView
        android:id="@+id/btn_delete_preset"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="?android:attr/selectableItemBackground"
        android:src="@drawable/ic_close_black_24dp"
        android:tint="@color/theme_accent"
        android:scaleType="center"
        android:contentDescription="@string/btn_delete_preset"
        android:clickable="true"
        android:focusable="false" />

</LinearLayout>
